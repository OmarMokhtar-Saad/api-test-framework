<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Everything: framework unit tests plus every example API test. Used by CI (`./mvnw verify`). -->
<!-- Listeners come from META-INF/services; -Dthreads=N overrides thread-count. -->
<suite name="all" parallel="methods" thread-count="4" data-provider-thread-count="4">
    <test name="unit">
        <packages>
            <package name="io.github.omarmokhtarsaad.apitest.unit"/>
        </packages>
        <classes>
            <class name="io.github.omarmokhtarsaad.apitest.framework.testng.ListenerRulesTest"/>
        </classes>
    </test>
    <test name="api">
        <packages>
            <package name="io.github.omarmokhtarsaad.apitest.tests.*"/>
        </packages>
    </test>
</suite>
