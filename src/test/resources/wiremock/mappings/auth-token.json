{
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "bodyPatterns": [
      { "contains": "grant_type=client_credentials" },
      { "contains": "client_id=demo" },
      { "contains": "client_secret=mock-secret" }
    ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": {
      "access_token": "mock-access-token",
      "token_type": "Bearer",
      "expires_in": 3600
    }
  }
}
